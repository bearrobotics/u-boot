// These variables are predefined in include/configs/rk3588_common.h:
//
// scriptaddr         = 0x00c00000
// script_offset_f    = 0xffe000
// script_size_f      = 0x2000
// pxefile_addr_r     = 0x00e00000
// kernel_addr_r      = 0x02000000
// kernel_comp_addr_r = 0x0a000000
// fdt_addr_r         = 0x12000000
// fdtoverlay_addr_r  = 0x12100000
// ramdisk_addr_r     = 0x12180000
// kernel_comp_size   = 0x8000000
//
// With this layout, the kernel image may grow up to 256 MiB before
// reaching fdt_addr_r, and the FDT itself has roughly 1 MiB of
// headroom below fdtoverlay_addr_r.
//
// The TPM event log buffer is 64 KiB at 0x28000000 (640 MiB). The
// ramdisk is expected to stay below 256 MiB (0x10000000 bytes), so the
// highest ramdisk end address is: 0x12180000 + 0x10000000 = 0x22180000
// which is well below the TPM log region at 0x28000000.
bootcmd=
	echo "Locating the boot partition...";
	gpt setenv mmc 0 boot;

	echo "Loading the Linux kernel image...";
	load mmc 0:$gpt_partition_entry $kernel_addr_r /Image;

	echo "Loading the FDT file...";
	load mmc 0:$gpt_partition_entry $fdt_addr_r $fdtfile;

	echo "Loading the initramfs image...";
	load mmc 0:$gpt_partition_entry $ramdisk_addr_r /initramfs.img;
	setenv ramdisk_size $filesize;

	// Seavo kernel hangs without trailing "sv" argument
	// See also: https://github.com/bearrobotics/bear-embsys-linuxkernel/blob/58a1c49ff2e8d3597d5846457d67cad2d33d2fa8/arch/arm64/kernel/setup.c#L325
	setenv bootargs ro sv;

	// With CONFIG_MEASURED_BOOT, booti measures kernel, initrd, and DTB.
	// See also: https://docs.u-boot.org/en/latest/usage/measured_boot.html
	echo "Starting Linux kernel...";
	booti $kernel_addr_r $ramdisk_addr_r:$ramdisk_size $fdt_addr_r;
